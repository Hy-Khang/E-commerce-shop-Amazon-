VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional — OpenRouteService key for route drawing (order tracking).
# NOT a secret: Vite inlines VITE_* vars into the client bundle. Empty → OSRM fallback.
# Get a free key at https://openrouteservice.org/dev/#/signup (no credit card).
VITE_ORS_API_KEY=

# Optional — MapTiler key for the map basemap (Streets style + Vietnamese labels).
# NOT a secret: Vite inlines VITE_* vars into the client bundle. Empty → OpenStreetMap fallback.
# Get a free key at https://cloud.maptiler.com/account/keys/ (no credit card).
# Since the key is exposed client-side, restrict it by domain in the MapTiler dashboard
# (add localhost + your production domain) rather than leaving it unrestricted.
VITE_MAPTILER_KEY=
