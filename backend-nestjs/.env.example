# App
APP_PORT=3000
APP_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
APP_URL=

# Database (Supabase / PostgreSQL)
# Use the SESSION POOLER connection (IPv4, port 5432) — the direct db.<ref>.supabase.co
# host is IPv6-only and fails on most dev machines. The pooler username is
# "postgres.<project-ref>". Copy these from Supabase → Project Settings → Database.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=your_password_here
DB_DATABASE=postgres
DB_SSL=true
# Dev only: auto-create/update schema on boot (never true in production).
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Supabase Storage (image uploads) — service-role key is BACKEND-ONLY (bypasses
# RLS); never expose it to the frontend. Create a PUBLIC bucket named below.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_BUCKET=product-images

# ETL only (one-time migration from the old SQL Server → Supabase).
# Point these at the legacy SQL Server; run `TZ=UTC npm run migrate:etl -- --with-files`.
SRC_DB_HOST=localhost
SRC_DB_PORT=1433
SRC_DB_USERNAME=sa
SRC_DB_PASSWORD=your_old_sqlserver_password
SRC_DB_DATABASE=ecommerce_shop

# JWT
JWT_ACCESS_SECRET=your_access_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRY=7d

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# SMTP (Mailtrap for dev)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ecommerce.local

# OAuth — Google (optional, leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# OAuth — Facebook (optional, leave empty to disable)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# VNPay Sandbox (optional, leave empty to disable)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return

# MoMo Sandbox (optional, leave empty to disable)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/api/v1/payments/momo/return
MOMO_IPN_URL=http://localhost:3000/api/v1/payments/momo/ipn

# AI provider — OpenRouter (one key powers both Visual Search + AI Chatbox/Agent).
# Get a key at https://openrouter.ai/keys and add credit at https://openrouter.ai/credits
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Visual Search (Module 12) — MUST be a VISION/multimodal model (sends image_url).
# DeepSeek has no vision model, so keep a multimodal one here. Verify the exact
# slug under the "Vision" filter at https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# AI Chatbox (Module 21) — text chat model. Defaults to OPENROUTER_MODEL if unset.
OPENROUTER_CHAT_MODEL=google/gemini-3.1-flash-lite

# AI Shopping Agent (Module 21 upgrade) — tool/function-calling-capable model.
# Needed for the agent to add-to-cart / propose checkout via tools. If unset,
# falls back to OPENROUTER_CHAT_MODEL and the agent self-degrades to plain RAG
# (a model that ignores tools just replies with text). gemini-3.1-flash-lite
# supports function-calling + vision and is cheaper on both axes than 3.5-flash-lite.
# Cheaper text-only alt (no vision, so agent/chat only): deepseek/deepseek-v4-flash.
OPENROUTER_AGENT_MODEL=google/gemini-3.1-flash-lite

# Smart Recommendations (Module 22) — opt-in AI-phrased "reason" copy on
# GET /recommendations. Default false → deterministic rule-based label
# ("Because you like {category}"), zero LLM latency/cost. Set true to have the
# OPENROUTER_CHAT_MODEL phrase the line (reuses OPENROUTER_API_KEY), cached
# in-memory per category; any miss (no key / error / timeout) falls back to the
# rule-based label, so enabling it never blocks or slows a cold cache request.
RECOMMENDATIONS_AI_REASON=false