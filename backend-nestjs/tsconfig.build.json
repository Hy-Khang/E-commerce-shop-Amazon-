{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Full, deterministic emit for prod/CI. The base tsconfig enables
    // `incremental` for fast dev rebuilds, but a persisted .tsbuildinfo (Render
    // caches it between deploys) makes tsc skip "unchanged" files when the
    // output layout changes → a partial dist missing files like app.config.js.
    "incremental": false
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "scripts",
    "**/*spec.ts",
    "src/core/database/migrations/_archive_mssql"
  ]
}
